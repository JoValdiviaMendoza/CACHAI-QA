{
  "name": "cachai-qa",
  "version": "1.0.0",
  "description": "Comprehensive Automated Checks & Headless Assertions Infrastructure - DUOC Alameda Capstone",
  "main": "dist/cli/index.js",
  "scripts": {
    "build": "tsc",
    "build:exe": "npm run build && pkg dist/cli/index.js --targets node18-win-x64 --output cachai-qa.exe",
    "test:cachai": "npm run build && node dist/cli/index.js",
    "test:local": "npm run build && node dist/cli/index.js --local",
    "test:browserstack": "npm run build && node dist/cli/index.js --browserstack",
    "crawl": "ts-node crawler.ts",
    "demo": "node demo/serve.js",
    "dashboard": "node dashboard/server.js",
    "crawl:headed": "ts-node crawler.ts --headless=false",
    "lint": "eslint src --ext .ts",
    "prettier": "prettier --write \"src/**/*.ts\""
  },
  "bin": "dist/cli/index.js",
  "pkg": {
    "assets": [
      "node_modules/@playwright/**/*",
      "node_modules/playwright/**/*"
    ],
    "scripts": "dist/**/*.js"
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "browserstack",
    "testing",
    "crawler"
  ],
  "author": "CACHAI-QA Team (Alex Puebla, Jose Valdivia)",
  "license": "MIT",
  "dependencies": {
    "@playwright/test": "^1.44.0",
    "axios": "^1.7.2",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "ora": "^5.4.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.0",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "inquirer": "^14.2.2",
    "pkg": "^5.8.1",
    "prettier": "^3.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

# ============================================
# CACHAI-QA Configuration
# ============================================
# Copia este archivo a .env y completa los valores

# --- URL Objetivo (OBLIGATORIO) ---
# La URL completa de la página web a escanear y evaluar
TARGET_URL=https://ejemplo.com

# --- Configuración de Escaneo ---
# Profundidad máxima de rastreo (0 = solo URL inicial, 1 = enlaces directos, etc.)
CRAWL_DEPTH=1

# Máximo de páginas a escanear (0 = sin límite)
MAX_PAGES=50

# Tiempo de espera para carga de página (ms)
PAGE_LOAD_TIMEOUT=30000

# Tiempo de espera para elementos dinámicos (ms)
ELEMENT_WAIT_TIMEOUT=10000

# User-Agent personalizado (opcional)
# USER_AGENT=CACHAI-QA/1.0 (+https://github.com/tu-repo/cachai-qa)

# --- Configuración de Playwright ---
# Navegadores a probar (chrome, firefox, webkit - separados por coma)
BROWSERS=chromium,firefox

# Modo headless (true/false)
HEADLESS=true

# Viewport para pruebas
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# --- BrowserStack Configuration (OBLIGATORIO para ejecución en la nube) ---
# Obtén estas credenciales en: https://www.browserstack.com/accounts/settings
BROWSERSTACK_USERNAME=tu_usuario_browserstack
BROWSERSTACK_ACCESS_KEY=tu_access_key_browserstack

# Nombre del proyecto en BrowserStack Dashboard
BROWSERSTACK_PROJECT_NAME=CACHAI-QA

# Nombre de la build (se puede sobrescribir con timestamp)
BROWSERSTACK_BUILD_NAME=cachai-qa-build

# Configuración de dispositivos/navegadores en BrowserStack
# Formato JSON: [{"browser": "chrome", "os": "Windows 10"}, {"browser": "firefox", "os": "Windows 10"}]
BROWSERSTACK_BROWSERS=[{"browser": "chrome", "os": "Windows 10", "browser_version": "latest"}, {"browser": "firefox", "os": "Windows 10", "browser_version": "latest"}]

# Tiempo límite de sesión en BrowserStack (segundos)
BROWSERSTACK_SESSION_TIMEOUT=300

# Habilitar video recording en BrowserStack
BROWSERSTACK_VIDEO=true

# Habilitar network logs en BrowserStack
BROWSERSTACK_NETWORK_LOGS=true

# Habilitar console logs en BrowserStack
BROWSERSTACK_CONSOLE_LOGS=true

# --- Configuración de Reportes ---
# Directorio local para reportes (además de BrowserStack)
REPORT_DIR=./reports

# Generar reporte HTML local
GENERATE_HTML_REPORT=true

# Generar reporte JSON
GENERATE_JSON_REPORT=true

# --- Configuración de Filtros ---
# Dominios permitidos para rastreo (vacío = solo mismo dominio de TARGET_URL)
# ALLOWED_DOMAINS=ejemplo.com,sub.ejemplo.com

# Dominios bloqueados (separados por coma)
BLOCKED_DOMAINS=facebook.com,twitter.com,linkedin.com,instagram.com,youtube.com

# Patrones de URL a ignorar (regex, separados por |)
IGNORE_URL_PATTERNS=.*\\.pdf$|.*\\.zip$|.*\\.exe$|.*mailto:.*|.*tel:.*

# --- Configuración de Pruebas Generadas ---
# Verificar enlaces rotos (HTTP 4xx, 5xx)
CHECK_BROKEN_LINKS=true

# Verificar carga de imágenes
CHECK_IMAGES=true

# Verificar formularios (presencia, validación básica)
CHECK_FORMS=true

# Verificar botones principales (CTAs, submit, etc.)
CHECK_BUTTONS=true

# Verificar errores de consola (JavaScript errors)
CHECK_CONSOLE_ERRORS=true

# Verificar accesibilidad básica (alt en imágenes, labels en inputs)
CHECK_A11Y_BASIC=true

# --- Configuración Avanzada ---
# Concurrencia máxima de páginas paralelas
MAX_CONCURRENCY=3

# Reintentos en fallos de red
RETRY_COUNT=2

# Delay entre requests (ms) - para ser educados con el servidor
REQUEST_DELAY=500

# Respetar robots.txt
RESPECT_ROBOTS_TXT=true